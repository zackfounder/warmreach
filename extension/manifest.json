{
  "manifest_version": 3,
  "name": "Warmreach",
  "version": "1.0.0",
  "description": "Free, open source LinkedIn outreach that runs in your own Chrome. Connects with no note, messages people only after they accept, follows up, and stops itself on any LinkedIn warning. No account, no server, no AI.",
  "permissions": ["storage", "unlimitedStorage", "alarms", "tabs", "notifications"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Warmreach", "default_popup": "popup.html" },
  "icons": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" },
  "content_scripts": [{ "matches": ["https://www.linkedin.com/*"], "js": ["actions.js"], "run_at": "document_idle" }],
  "options_ui": { "page": "options.html", "open_in_tab": true }
}
